# Juniper config file for launching Stage 1: JWST Detector1Pipeline and 1/f Corrections

# Setup for Stage 1
toplevel_dir    ''                                          # Top-level directory for all files in this project. The input and output files should be here.
input           'uncal'                                     # The sub-directory relative to the top-level directory where your input *uncal.fits files are.
output          's1_rates'                                  # The sub-directory relative to the top-level directory where your output *rateints.fits files will be saved.
input_run       None                                        # str or None. You can use this to choose a sub-folder from the input folder if you wanted to rerun (e.g. pull from input/nrs1 instead of input/ or input/nrs2).
output_run      None                                        # str or None. You can use this to open sub-folders in the output folder if you wanted to rerun (e.g. have output/run1 and output/run2).
CRDS_PATH       None                                        # str or None. If you already have a crds_cache directory, point to its absolute path here. Otherwise, a crds_cache will be opened in the current working directory.
max_cores       'half'                                      # integer or 'quarter', 'half', 'all'. How many cores to use for multiprocessing.
verbose         2                                           # Int from 0 to 2. 0 = print nothing. 1 = print some statements. 2 = print every action.
show_plots      2                                           # Int from 0 to 2. 0 = show nothing. 1 = show some plots. 2 = show all plots.
save_plots      2                                           # Int from 0 to 2. 0 = save nothing. 1 = save some plots. 2 = save all plots.
diagnostics     'diagnostics'                               # str. If save_plots >= 1, diagnostic plots will be written to this folder relative to output (and run_name, if applicable).
rename          'name'                                      # str. What you want to rename the files to. Can be None to keep the default name. Suggestions include naming the files after the target planet and program ID (e.g. 'PLANET-B_ID12345').

# Step 1: JWST Detector1Pipeline
do_group_scale  True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.

do_dq_init      True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.
user_dq         './'                                        # str. Path to a user-supplied DQ reference fits file pre-populated with desired DQ flags.

do_saturation   True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.
sat_growth      1                                           # int. If do_saturation is True, how far away saturation should be flagged from the initial flagged pixel, which helps account for bloom.

do_refpix       True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.
odd_even_col    True                                        # bool. Keyword of the refpix step. NIR data only.
use_side_ref    True                                        # bool. Keyword of the refpix step. NIR data only.
side_smooth_len 11                                          # bool. Keyword of the refpix step. Only applies if use_side_ref is True.
side_gain       1.0                                         # bool. Keyword of the refpix step. Only applies if use_side_ref is True.
odd_even_row    False                                       # bool. Keyword of the refpix step. Ignored for NIR data if side ref pixels are used.
ovr_corr_mit    3.0                                         # bool. Keyword of the refpix step. NIRSpec IRS2 mode only.
pres_irs2_ref   False                                       # bool. Keyword of the refpix step. Always False for science operations, only ever True for some diagnostics or calibrations.

do_linearity    True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.

do_dark_current True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.
dark_output     None                                        # str or None. If str, dark data will be saved with this name.
avg_dark        None                                        # float or None. If float, it is the average dark current in e-/s and is used to calculate Poisson noise from dark current.

do_jump         True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.
rej_threshold   15                                          # float. The sigma threshold at which to flag a jump.
three_group_rej 6                                           # float. The sigma threshold at which to flag a jump if you only have three groups.
four_group_rej  5                                           # float. The sigma threshold at which to flag a jump if you only have four groups.
flag_4          True                                        # bool. If True, flags the four adjacent pixels to a jump as also jumping.
max_jump        200                                         # float. Pixels jumping above this threshold are exempted from neighbor flagging. This value should be much higher than rej_threshold to ensure proper functionality!
min_jump        20                                          # float. Pixels jumping below this threshold are exempted from neighbor flagging. This is because a very small jump is unable to jump its neighbors via inter-pixel capacitance. This value should be larger than rej_threshold to ensure proper functionality!
expand_events   True                                        # bool. If True, expands contiguous CR flags with ellipses to catch all affected pixels. In the NIR these events are snowballs; in the MIR these are CR showers.

do_cleanflicker False                                       # bool. Whether to perform this step in jwst Detector1Pipeline.
autoparam       False                                       # bool. If True, automatically selects some fit and background parameters when possible.
fit_method      'median'                                    # str. The noise fitting algorithm to use, with options 'fft' or 'median'.
fit_by_channel  False                                       # bool. If True, fits flicker noise separately for each channel. Ignored by MIRI, subarrays, and 'fft' method.
bkg_method      'median'                                    # str. Background structure fitting method to use, with options 'median', 'model', 'median_image', or None.
bkg_box_size    None                                        # lst of int, or None. Box size for the data grid when using method 'model'.
mask_sci_regs   False                                       # bool. Masks traces and/or non-science regions depending on detector.
apply_flatfield False                                       # bool. If True, flat-corrects images prior to fitting background level.
n_sigma         2.0                                         # float. Sigma-clipping threshold for rejecting outliers and illuminated pixels.
fit_histogram   False                                       # bool. If True, the sigma threshold for n_sigma will be derived from a Gaussian fit of the values.
single_mask     True                                        # bool. If True, makes just one data mask for all the data.
user_mask       './'                                        # str. Points to a custom user-supplied data mask.
save_mask       False                                       # bool. Whether to save this output of this step.
save_background False                                       # bool. Whether to save this output of this step.
save_noise      False                                       # bool. Whether to save this output of this step.

do_ramp_fit     True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.
algorithm       "OLS_C"                                     # str. The algorithm to use to fit the ramp. Defaults to "OLS_C" but "LIKELY" is also an option.
firstgroup      None                                        # int or None. If not None, ignores all groups before this one when fitting the ramp.
lastgroup       None                                        # int or None. If not None, ignores all groups after this one when fitting the ramp.
save_opt        False                                       # bool. Whether to save optional outputs from this step.
opt_name        None                                        # str or None. If saving the optional outputs, what to name it.
int_name        None                                        # str or None. If saving the optional outputs, what to name the per-integration product.
suppress_one    True                                        # bool. Whether to suppress calculations when only one group is not fully saturated.

do_gain_scale   True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.

# Step 1a: NIRSpec-specific steps
do_superbias    True                                        # bool. Whether to perform this step in jwst Detector1Pipeline.

do_persistence  False                                       # bool. Whether to perform this step in jwst Detector1Pipeline. Does not apply to TSOs so usually we do not use this in exoplanetary sciences.

do_charge_mig   False                                       # bool. Whether to perform this step in jwst Detector1Pipeline. Does not apply to TSOs so usually we do not use this in exoplanetary sciences.
signal_thres    25000                                       # float. If charge migration is performed, this is the threshold at which a pixel gets flagged as DO_NOT_USE.

do_pictureframe False                                       # bool. Whether to perform this step in jwst Detector1Pipeline. Applies only to NIRSpec full-frame images.
mask_sci_pict   False                                       # bool. Masks traces defined by WCS bounding boxes for slits/slices.
n_sigma_pict    2.0                                         # float. Sigma-clipping threshold for rejecting outliers and illuminated pixels.
save_mask_pict  False                                       # bool. Whether to save this output of this step.
save_correction False                                       # bool. Whether to save this output of this step.

# Step 1b: MIRI-specific steps
do_emicorr      False                                       # bool. Whether to perform this step in jwst Detector1Pipeline. Corrects for 390 Hz or other electromagnetic interference (EMI) noise patterns in the raw ramp data.
emi_algorithm   'joint'                                     # str. Algorithm for emicorr fitting, with options 'joint' or 'sequential'.
nints_to_phase  None                                        # int or None. Number of integrations to phase for sequential algorithm.
nbins           None                                        # int or None.  Number of bins in one phased wave for sequential algorithm.
scale_reference True                                        # bool. If True and using sequential algorithm, reference wavelength will be scaled to the data's phase amplitude.
onthefly_corrf  None                                        # lst or None. Frequency values to use to create a correction on-the-fly. Will ignore input EMICORR reference models.
use_n_cycles    3                                           # int. Number of cycles for calculating phase for sequential algorithm.
fit_ints_sep    False                                       # bool. If True, fit and remove EMI noise for each integration separately for joint algorithm.
save_int_result False                                       # bool. Whether to save intermediate results of this step.

do_lastframe    False                                       # bool. Whether to perform this step in jwst Detector1Pipeline. Flags the last group of every frame as DO_NOT_USE if the total number of groups in each integration is greater than 2.

do_reset        False                                       # bool. Whether to perform this step in jwst Detector1Pipeline, which attempts to correct for the reset anomaly effect present in the first roughly 15 groups of an integration.

do_rscd         False                                       # bool. Whether to perform this step in jwst Detector1Pipeline. Attempts to fix the Reset Switch Charge Decay effect by flagging the first group in all integrations after the first as DO_NOT_USE.

# Step 2: Specialized background subtraction routines
# Step 2a: Group-level background subtraction
do_glbs         True                                        # bool. Whether to perform this step. Can reduce NIRSpec scatter by thousands of ppm. Not for use with MIRI LRS!
glbs_sigma      10                                          # float. How aggressively to clean outliers from the background region during glbs.
glbs_kernel     (1,31)                                      # tuple of odd ints. The rows x cols to span during filtering of the background. Recommended to filter over many columns and just one row to avoid trace signal.
glbs_rows       [0,1,2,3,4,5,-6,-5,-4,-3,-2,-1]             # list of ints. Row indices to use as the background. Best used with a straight trace. Never ignored unless empty.
glbs_mask       True                                        # bool. Whether to mask the trace while computing the background values. Best used with a curving trace.
glbs_threshold  10000                                       # float. Median last group's lowest signal level which still confidently constitutes part of the trace, thus sets the minimum value to be masked. Only called if glbs_mask is True and glbs_com_mask is None.
glbs_com_mask   7                                           # int or None. If not None, identifies the COM of each column and then masks all pixels +/- this value from the COM to build a mask. Only called if glbs_mask is True. Overrides glbs_threshold if not None.
glbs_upw_mask   7                                           # int or None. If not None, applies this mask in the upwards spatial direction. Useful if your trace is asymmetric due to e.g. CTE.
glbs_low_contr  False                                       # bool. If True, uses powers to amplify faint trace signal. Useful if the COM locator is struggling to find your trace because of low contrast against a bright background.

# Step 2b: MIRI LRS group-level background subtraction
do_miribckg     False                                       # bool. Whether to use a MIRI LRS background exposure (typically taken immediately after the science exposure) to correct the MIRI LRS background.
miribckg_path   "./"                                        # str. The path to the MIRI LRS background *uncal.fits file.

# ENDPARSE